# Normalize text files across Windows, Linux, and macOS.
* text=auto eol=lf

# Windows-native scripts retain CRLF endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

