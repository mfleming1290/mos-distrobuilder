#!/bin/bash

PLUGIN_NAME="distrobuilder"
PLG_DIR="/boot/optional/plugins/$PLUGIN_NAME"
SETTINGS_FILE="$PLG_DIR/settings.json"
STATIC_DIR="$PLG_DIR/staticfiles"
DEFAULT_DEFINITION="$STATIC_DIR/definitions/gameserver.yaml"
DISTROBUILDER="/usr/bin/distrobuilder-real"
CONTROLLER="/usr/bin/plugins/distrobuilder"

TEMPLATE_DIR=""
BUILD_DIR=""
LOG_DIR=""
CACHE_DIR=""
SELECTED_TEMPLATE=""

_ensure_settings() {
  if [ ! -f "$SETTINGS_FILE" ]; then
    mkdir -p "$PLG_DIR"
    cat > "$SETTINGS_FILE" <<'JSON'
{
  "template_dir": "/mnt/user/@storage/distrobuilder/templates",
  "build_dir": "/mnt/user/@storage/distrobuilder/builds",
  "cache_dir": "/mnt/user/@storage/distrobuilder/cache",
  "log_dir": "/mnt/user/@storage/distrobuilder/logs",
  "selected_template": ""
}
JSON
  fi
}

_load_settings() {
  _ensure_settings
  TEMPLATE_DIR="$(jq -r '.template_dir // empty' "$SETTINGS_FILE" 2>/dev/null)"
  BUILD_DIR="$(jq -r '.build_dir // empty' "$SETTINGS_FILE" 2>/dev/null)"
  CACHE_DIR="$(jq -r '.cache_dir // empty' "$SETTINGS_FILE" 2>/dev/null)"
  LOG_DIR="$(jq -r '.log_dir // empty' "$SETTINGS_FILE" 2>/dev/null)"
  SELECTED_TEMPLATE="$(jq -r '.selected_template // empty' "$SETTINGS_FILE" 2>/dev/null)"
}

_ensure_dirs() {
  _load_settings
  [ -n "$TEMPLATE_DIR" ] || { echo "Template folder is not configured." >&2; return 1; }
  [ -n "$BUILD_DIR" ] || { echo "Build folder is not configured." >&2; return 1; }
  [ -n "$CACHE_DIR" ] || { echo "Cache folder is not configured." >&2; return 1; }
  [ -n "$LOG_DIR" ] || { echo "Log folder is not configured." >&2; return 1; }
  mkdir -p "$TEMPLATE_DIR" "$BUILD_DIR" "$LOG_DIR" "$CACHE_DIR" "$PLG_DIR/bin"
}

_seed_default_template() {
  _ensure_dirs || return 1
  if [ -f "$DEFAULT_DEFINITION" ] && [ ! -f "$TEMPLATE_DIR/gameserver.yaml" ]; then
    cp -f "$DEFAULT_DEFINITION" "$TEMPLATE_DIR/gameserver.yaml"
  fi
}

_sync_builtin_template() {
  _ensure_dirs || return 1
  if [ -f "$DEFAULT_DEFINITION" ]; then
    cp -f "$DEFAULT_DEFINITION" "$TEMPLATE_DIR/gameserver.yaml"
  fi
}

_require_binary() {
  if [ ! -x "$DISTROBUILDER" ]; then
    echo "Distrobuilder runtime is not installed." >&2
    return 1
  fi
}

_resolve_template() {
  _ensure_dirs || return 1
  local requested="$SELECTED_TEMPLATE"
  [ -n "$requested" ] || requested="gameserver.yaml"

  local safe
  safe="$(basename "$requested")"

  case "$safe" in
    *.yaml|*.yml) ;;
    *) echo "Selected template must be a .yaml or .yml file." >&2; return 1 ;;
  esac

  local def="$TEMPLATE_DIR/$safe"
  [ -f "$def" ] || { echo "Template not found: $def" >&2; return 1; }
  printf '%s\n' "$def"
}

install() {
  "$CONTROLLER" install_binary
  _sync_builtin_template
}

plugin_update() {
  "$CONTROLLER" install_binary
  _sync_builtin_template
}

uninstall() {
  rm -f /usr/bin/distrobuilder-real
}

mos_start() {
  "$CONTROLLER" deploy_binary 2>/dev/null || true
  _seed_default_template 2>/dev/null || true
}

mos_osupdate() {
  "$CONTROLLER" deploy_binary 2>/dev/null || true
  _seed_default_template 2>/dev/null || true
}

prepare_storage() {
  _seed_default_template
  echo "Template folder: $TEMPLATE_DIR"
  echo "Build folder: $BUILD_DIR"
  echo "Cache folder: $CACHE_DIR"
  echo "Log folder: $LOG_DIR"
}

validate_selected() {
  _require_binary || return 1
  _ensure_dirs || return 1

  local def
  def="$(_resolve_template)" || return 1

  local name log
  name="$(basename "$def")"
  log="$LOG_DIR/validate-${name%.*}.log"

  echo "Validating: $def" | tee "$log"
  "$DISTROBUILDER" validate "$def" 2>&1 | tee -a "$log"
}

_normalize_lxc_metadata() {
  local out="$1"
  local meta="$out/meta.tar.xz"

  [ -f "$meta" ] || { echo "Missing LXC metadata archive: $meta" >&2; return 1; }

  local tmp
  tmp="$(mktemp -d)"
  tar -xJf "$meta" -C "$tmp" || { rm -rf "$tmp"; return 1; }

  cat > "$tmp/config" <<'EOF'
lxc.include = LXC_TEMPLATE_CONFIG/common.conf
lxc.arch = linux64
EOF

  for suffix in 1 2 3 4; do
    cat > "$tmp/config.$suffix" <<'EOF'
lxc.include = LXC_TEMPLATE_CONFIG/debian.common.conf
lxc.arch = linux64
EOF
  done

  cat > "$tmp/config-user" <<'EOF'
lxc.include = LXC_TEMPLATE_CONFIG/common.conf
lxc.include = LXC_TEMPLATE_CONFIG/userns.conf
lxc.arch = linux64
EOF

  for suffix in 1 2 3 4; do
    cat > "$tmp/config-user.$suffix" <<'EOF'
lxc.include = LXC_TEMPLATE_CONFIG/debian.common.conf
lxc.include = LXC_TEMPLATE_CONFIG/debian.userns.conf
lxc.arch = linux64
EOF
  done

  cat > "$tmp/templates" <<'EOF'
/etc/hostname
/etc/hosts
EOF

  # Force lxc-download to re-check the registry on each create. If the
  # build ID is unchanged it will reuse the cached rootfs; if a newer
  # build exists it will download it instead of staying on a stale image.
  printf '0\n' > "$tmp/expiry"

  tar -cJf "$meta.new" -C "$tmp" .
  mv -f "$meta.new" "$meta"
  rm -rf "$tmp"

  echo "Normalized LXC metadata: $meta"
}

build_selected() {
  _require_binary || return 1
  _ensure_dirs || return 1

  local def
  def="$(_resolve_template)" || return 1

  local filename stem stamp out log
  filename="$(basename "$def")"
  stem="${filename%.*}"
  stamp="$(date +%Y%m%d-%H%M%S)"
  out="$BUILD_DIR/${stem}-${stamp}"
  log="$LOG_DIR/build-${stem}-${stamp}.log"

  mkdir -p "$out"

  echo "Building LXC image" | tee "$log"
  echo "Template: $def" | tee -a "$log"
  echo "Output:   $out" | tee -a "$log"
  echo "Cache:    $CACHE_DIR" | tee -a "$log"

  "$DISTROBUILDER" \
    --cache-dir "$CACHE_DIR" \
    build-lxc "$def" "$out" \
    --compression=xz \
    2>&1 | tee -a "$log"

  local rc=${PIPESTATUS[0]}
  [ "$rc" -eq 0 ] || return "$rc"

  _normalize_lxc_metadata "$out" || return 1

  # lxc-download keeps its own image cache under /var/cache/lxc/download.
  # Remove this distribution's cached copy so the next MOS create checks
  # the registry and picks up the build we just published.
  rm -rf "/var/cache/lxc/download/$stem"

  ln -sfn "$out" "$BUILD_DIR/latest-${stem}"
  cp -f "$log" "$LOG_DIR/latest-build.log"

  echo "Build completed: $out" | tee -a "$log"
  ls -lah "$out" | tee -a "$log"
}
